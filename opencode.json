{
  "instructions": [],
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": 25000
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "analysis": false
      }
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      },
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "analysis": true
      }
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "options": {
        "reasoningEffort": "max",
        "temperature": 0.7
      },
      "tools": {
        "bash": true,
        "webfetch": true
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "openrouter": {
      "models": {
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "only": [
                "minimax/fp8"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "only": [
                "minimax/fp8"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/autofs/projects-t3/lilab/yangqisu/.local/miniforge3/envs/work_base/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
