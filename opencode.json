{
  "instructions": [],
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/autofs/projects-t3/lilab/yangqisu/repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/local/projects-t3/lilab/yangqisu/repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/autofs/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/local/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "allow" },
    { "action": "read", "resource": "/autofs/projects-t3/lilab/yangqisu/repos/*", "effect": "allow" },
    { "action": "read", "resource": "/local/projects-t3/lilab/yangqisu/repos/*", "effect": "allow" },
    { "action": "read", "resource": "/autofs/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "allow" },
    { "action": "read", "resource": "/local/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "allow" }
  ],
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      { "action": "permission", "resource": "edit:/autofs/projects-t3/lilab/yangqisu/repos/*", "effect": "deny" },
      { "action": "permission", "resource": "edit:/local/projects-t3/lilab/yangqisu/repos/*", "effect": "deny" },
      { "action": "permission", "resource": "edit:/autofs/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "deny" },
      { "action": "permission", "resource": "edit:/local/projects-t3/lilab/yangqisu/.local/miniforge3/*", "effect": "deny" }
    ]
  },
  "lsp": true,
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 25000
    },
    "buffer": 25000
  },
  "agent": {
    "plan": {
      "model": "opencode-go/kimi-k2.6",
      "options": {
        "reasoningEffort": "high",
        "temperature": 1.0,
        "top_p": 0.95
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "analysis": false
      }
    },
    "build": {
      "model": "openai/gpt-6-astra",
      "options": {
        "reasoningEffort": "medium"
      },
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "analysis": true
      }
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      }
    },
    "explore": {
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      },
      "tools": {
        "bash": true,
        "webfetch": true
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "openrouter": {
      "models": {
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
              "allow_fallbacks": false
            }
          }
        },
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
              "allow_fallbacks": false
            }
          }
        }

      }
    }
  }
}
