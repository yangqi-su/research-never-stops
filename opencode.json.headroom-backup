{
  "instructions": [],
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 25000
    },
    "buffer": 25000
  },
  "agent": {
    "plan": {
      "model": "opencode-go/kimi-k2.6",
      "options": {
        "reasoningEffort": "high",
        "temperature": 1.0,
        "top_p": 0.95
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "analysis": false
      }
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      },
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "analysis": true
      }
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "high",
        "temperature": 0.7
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "options": {
        "reasoningEffort": "max",
        "temperature": 0.7
      },
      "tools": {
        "bash": true,
        "webfetch": true
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "openrouter": {
      "models": {
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
              "allow_fallbacks": false
            }
          }
        },
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
              "allow_fallbacks": false
            }
          }
        }

      }
    }
  }
}
